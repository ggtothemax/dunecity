# Apache 2.4 + mod_php or php-fpm. Nothing here needs a module the shared host does not
# already have: no proxy, no rewrite map, no daemon.
Options -Indexes -ExecCGI +SymLinksIfOwnerMatch
DirectoryIndex index.php

# Bounded before PHP is reached. Workshop manifests use at most 524288 bytes
# after hex encoding; PHP retains the smaller per-route signaling limits.
LimitRequestBody 524288

RewriteEngine On
# Only the known routes reach PHP. Anything else is a 404 from Apache, which keeps a scanner
# out of the interpreter entirely.
RewriteRule ^(?:v1/health|v1/admission/(?:host|join|list|visibility|inspect|request|request-status)|v1/content/(?:list|begin|chunk|commit|manifest|blob|lookup)|v1/lobby/(?:enter|poll|say)|v1/p2p/(?:session|poll|signal|phase|leave|join-requests))$ index.php [END]

<IfModule mod_headers.c>
    # These bodies carry invitation codes, grants and session tokens.
    Header always set Cache-Control "no-store"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# The state directory lives outside the web root, but if an operator ever puts one here by
# mistake, it is not served.
<FilesMatch "\.(json|jsonl|log)$">
    Require all denied
</FilesMatch>
